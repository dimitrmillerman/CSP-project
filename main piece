#create a turtle
turtle_shape = "turtle"
turtle_color = "green"
swimmer = trtl.Turtle()
swimmer.shape(turtle_shape)
swimmer.color(turtle_color)
swimmer.shapesize(3, 3)  # make it big
swimmer.penup()
swimmer.speed(0)


#create staring point and radius of the turtles movement in a circular path
center_x, center_y = 0, 250  
radius = 150


# move the turtle in a circular path using iteration
def swim():
    while True:
        for angle in range(0, 360, 4):
            rad = math.radians(angle)
            x = center_x + radius * math.cos(rad)
            y = center_y + radius * math.sin(rad)
            swimmer.goto(x, y)
            heading = math.degrees(math.atan2(y - center_y, x - center_x)) + 90
            swimmer.setheading(heading)
            time.sleep(0.03)  # control the speed of the turtle's movement

swim()
screen.mainloop()


